---
import { site } from '../site.config';
import { withBase } from '../lib/locations';

interface Props {
  active?: 'explore' | 'gallery' | 'about' | 'contact';
}
const { active = 'explore' } = Astro.props;
const links = [
  { id: 'explore', label: 'Explore', href: withBase('') },
  { id: 'gallery', label: 'Gallery', href: withBase('gallery/') },
  { id: 'about', label: 'About', href: withBase('about/') },
  { id: 'contact', label: 'Contact', href: withBase('contact/') },
] as const;
---

<header class="site-header" data-header>
  <a class="brand" href={withBase('')} data-nav-home aria-label={`${site.title}, home`}>
    <span class="brand-mark" aria-hidden="true">
      <span>{site.logo.first}</span><span class="brand-slash"></span><span class="brand-dim">{site.logo.second}</span><span>{site.logo.third}</span>
    </span>
    <span class="brand-byline" aria-hidden="true">
      <span>{site.byline[0]}</span>
      <span>{site.byline[1]}</span>
    </span>
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
    <span class="menu-toggle-bars" aria-hidden="true"></span>
    <span class="visually-hidden">Menu</span>
  </button>

  <nav class="site-nav" id="site-nav" aria-label="Main">
    <ul>
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={active === l.id ? 'page' : undefined}
              data-nav-home={l.id === 'explore' ? '' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="site-nav-legal">
      <li><a href={withBase('privacy/')}>Privacy &amp; cookies</a></li>
      <li><button class="text-btn" type="button" data-consent-open>Cookie settings</button></li>
    </ul>
  </nav>
</header>
