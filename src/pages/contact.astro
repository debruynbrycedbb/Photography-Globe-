---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
const { email, instagram } = site.contact;
const hasAny = email || instagram;
---

<Base title="Contact" active="contact" bodyClass="is-gallery-page">
  <main id="main" class="page">
    <header class="page-head">
      <p class="tag">Contact</p>
      <h1 class="page-title">Get in touch</h1>
    </header>
    <div class="prose">
      {
        hasAny ? (
          <ul class="contact-list">
            {email && (
              <li>
                Email: <a href={`mailto:${email}`}>{email}</a>
              </li>
            )}
            {instagram && (
              <li>
                Instagram: <a href={`https://instagram.com/${instagram.replace(/^@/, '')}`}>{instagram}</a>
              </li>
            )}
          </ul>
        ) : (
          <p>
            <strong>No contact details have been added yet.</strong> Add an email address or Instagram
            handle in <code>src/site.config.ts</code> and they will appear here.
          </p>
        )
      }
    </div>
  </main>
</Base>
