---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/manrope';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Consent from '../components/Consent.astro';
import { site } from '../site.config';
import { withBase } from '../lib/locations';

interface Props {
  title?: string;
  description?: string;
  active?: 'explore' | 'gallery' | 'about' | 'contact';
  bodyClass?: string;
  ogImage?: string;
  /** Small footer with privacy links (the globe pages have their own). */
  footer?: boolean;
}
const { title, description = site.description, active, bodyClass = '', ogImage, footer = true } = Astro.props;
const fullTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-base={withBase('')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#04080a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header active={active} />
    <slot />
    {
      footer && (
        <footer class="site-footer">
          <span>© {new Date().getFullYear()} Bryce de Bruyn</span>
          <a href={withBase('privacy/')}>Privacy &amp; cookies</a>
          <button class="text-btn" type="button" data-consent-open>Cookie settings</button>
        </footer>
      )
    }
    <Consent />
    <script>
      // Mobile menu
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('menu-open', open);
      });
    </script>
  </body>
</html>
